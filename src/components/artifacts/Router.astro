---
const routes = [
  {
    id: 'structure',
    label: '结构还没定',
    target: 'html-wireframe',
    why: '要决定信息层级、导航和移动端重排，先用两个低保真方向比较，别急着上视觉。',
  },
  {
    id: 'flow',
    label: '流程要点通',
    target: 'html-prototype',
    why: '评审问题是输入、状态与恢复，需要一条真能点通的流程，而不是一张静态截图。',
  },
  {
    id: 'relation',
    label: '关系要说清',
    target: 'html-diagram',
    why: '内容是拓扑或时序，选对模型比写三段说明更准确。',
  },
  {
    id: 'broad',
    label: '以上都不是',
    target: 'html',
    why: '报告、说明文档、演示文稿与混合成果，由通用技能收口。',
  },
];
---

<div class="router" data-tabs-scope>
  <div class="prompt">
    <span class="kicker">一条真实请求</span>
    <p>「把结算页改版的评审材料整理出来，让设计、工程和 PM 能在同一处达成结论。」</p>
  </div>

  <div class="grid">
    <div
      class="tabs"
      data-tablist
      role="tablist"
      aria-label="按主评审问题选择路由"
      aria-orientation="vertical"
    >
      {
        routes.map((route, i) => (
          <button
            type="button"
            role="tab"
            id={`route-tab-${route.id}`}
            data-tab={route.id}
            aria-controls={`route-panel-${route.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {route.label}
          </button>
        ))
      }
    </div>

    <div class="panels">
      {
        routes.map((route, i) => (
          <div
            class="panel"
            role="tabpanel"
            id={`route-panel-${route.id}`}
            data-panel={route.id}
            aria-labelledby={`route-tab-${route.id}`}
            hidden={i > 0}
          >
            <p class="arrow">→ 交给 <code>{route.target}</code></p>
            <p>{route.why}</p>
            <p class="rule">路由原则：用最窄的那个技能承担主评审问题。</p>
          </div>
        ))
      }
    </div>
  </div>

  <style>
    .router { min-width: 0; font-family: var(--font-sans); }
    .prompt { border: 1px solid var(--color-rule); background: var(--color-paper-deep); padding: 12px 14px; }
    .kicker { font: 10px var(--font-mono); text-transform: uppercase; letter-spacing: 0.16em; color: var(--color-ink-faint); }
    .prompt p { margin: 6px 0 0; font-size: 13px; line-height: 1.7; color: var(--color-ink-soft); }
    .grid { display: grid; grid-template-columns: minmax(0, 148px) minmax(0, 1fr); gap: 12px; margin-top: 12px; }
    .tabs { display: flex; flex-direction: column; gap: 6px; }
    .tabs button { text-align: left; padding: 9px 10px; border: 1px solid var(--color-rule); background: transparent; font: 12px var(--font-sans); color: var(--color-ink-soft); cursor: pointer; }
    .tabs button[aria-selected='true'] { border-left: 3px solid var(--color-accent); background: var(--color-paper-deep); color: var(--color-ink); }
    .panel { min-width: 0; min-height: 116px; border: 1px solid var(--color-rule); padding: 14px 16px; font-size: 13px; line-height: 1.75; color: var(--color-ink-soft); }
    .panel p { margin: 0; }
    .arrow { font-family: var(--font-mono); font-size: 12px; color: var(--color-ink); }
    .rule { margin-top: 10px !important; padding-top: 8px; border-top: 1px dashed var(--color-rule); font-size: 11px; color: var(--color-ink-faint); }
    @media (max-width: 560px) {
      .grid { grid-template-columns: 1fr; }
      .tabs { flex-direction: row; flex-wrap: wrap; }
      .tabs button { flex: 1 1 auto; }
    }
  </style>
</div>
