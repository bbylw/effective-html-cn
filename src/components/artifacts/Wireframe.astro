---
const directions = [
  {
    id: 'sidebar',
    label: 'A · 侧栏概览',
    tradeoff: '一屏看全，适合逐项核对清单；窄屏时导航必须折叠。',
  },
  {
    id: 'steps',
    label: 'B · 分步流程',
    tradeoff: '一次只答一个问题，适合第一次参与评审；看不到全局。',
  },
];
---

<div class="wf" data-tabs-scope>
  <div class="wfbar" data-tablist role="tablist" aria-label="比较两个结构方向">
    {
      directions.map((direction, i) => (
        <button
          type="button"
          role="tab"
          id={`wf-tab-${direction.id}`}
          data-tab={direction.id}
          aria-selected={i === 0 ? 'true' : 'false'}
        >
          {direction.label}
        </button>
      ))
    }
  </div>

  <div
    class="frame"
    role="tabpanel"
    id="wf-panel-sidebar"
    data-panel="sidebar"
    aria-labelledby="wf-tab-sidebar"
  >
    <div class="frame-surface">
    <div class="layout-a">
      <nav aria-label="评审区块">
        <p>结算页改版</p>
        <ul>
          <li>发布清单</li>
          <li>评审人</li>
          <li>阻塞项</li>
        </ul>
      </nav>
      <section>
        <h4>发布清单 · 待评审</h4>
        <div class="table-scroll" tabindex="0" role="region" aria-label="发布清单表格">
          <table>
            <thead><tr><th>条目</th><th>负责人</th><th>状态</th></tr></thead>
            <tbody>
              <tr><td>金额校验文案</td><td>设计</td><td>待确认</td></tr>
              <tr><td>退款入口位置</td><td>工程</td><td>已通过</td></tr>
            </tbody>
          </table>
        </div>
        <button type="button" disabled>标记已评审（原型阶段开放）</button>
      </section>
    </div>
    <p class="tradeoff">权衡：{directions[0].tradeoff}</p>
    </div>
  </div>

  <div
    class="frame"
    role="tabpanel"
    id="wf-panel-steps"
    data-panel="steps"
    aria-labelledby="wf-tab-steps"
    hidden="until-found"
  >
    <div class="frame-surface">
    <ol class="steps">
      <li>1 内容</li><li aria-current="step">2 评审人</li><li>3 结论</li>
    </ol>
    <div class="step-body">
      <h4>第 2 步 · 指定评审人</h4>
      <p>设计：林岚　工程：周叙　PM：陈可</p>
      <p>三人确认后才进入「结论」，顺序不可跳过。</p>
      <button type="button" disabled>下一步（原型阶段开放）</button>
    </div>
    <p class="tradeoff">权衡：{directions[1].tradeoff}</p>
    </div>
  </div>

  <style>
    .wf { min-width: 0; font-family: system-ui, sans-serif; color: #333; }
    .wfbar { display: flex; flex-wrap: nowrap; gap: 0; overflow-x: auto; border: 1px solid #aaa; }
    .wfbar button { position: relative; flex: 1 0 auto; white-space: nowrap; padding: 8px 10px; border: 0; border-right: 1px solid #aaa; background: #f2f2f2; font: 0.75rem system-ui, sans-serif; color: #444; cursor: pointer; }
    .wfbar button:last-child { border-right: 0; }
    .wfbar button[aria-selected='true'] { color: #111; }
    .wfbar button[aria-selected='true']::after { content: ''; position: absolute; inset: auto 0 0; border-block-end: 2px solid #111; }
    .frame { min-width: 0; }
    .frame-surface { min-width: 0; border: 1px solid #aaa; border-top: 0; padding: 12px; background: #fff; }
    /* 键盘也能滚动窄屏下的表格：容器可聚焦且有可访问名称。 */
    .table-scroll { max-inline-size: 100%; overflow-x: auto; container-type: inline-size; }
    .layout-a { display: grid; grid-template-columns: minmax(0, 140px) minmax(0, 1fr); gap: 12px; }
    .layout-a nav { border: 1px solid #bbb; padding: 8px; background: #f7f7f7; }
    .layout-a nav p { margin: 0 0 8px; font-size: 0.75rem; font-weight: 600; }
    .layout-a nav ul { margin: 0; padding-left: 16px; font-size: 0.75rem; line-height: 1.9; }
    .layout-a section { min-width: 0; border: 1px solid #bbb; padding: 10px; }
    h4 { margin: 0 0 8px; font: 0.8125rem system-ui, sans-serif; font-weight: 600; color: #222; }
    table { width: 100%; border-collapse: collapse; font-size: 0.6875rem; }
    th, td { border: 1px solid #ccc; padding: 5px 6px; text-align: left; }
    th { background: #f2f2f2; }
    button:disabled { margin-top: 10px; padding: 5px 10px; border: 1px solid #bbb; background: #eee; color: #666; font: 0.6875rem system-ui, sans-serif; }
    .steps { display: flex; gap: 0; margin: 0; padding: 0; list-style: none; border: 1px solid #bbb; }
    .steps li { flex: 1 1 auto; padding: 7px 8px; border-right: 1px solid #bbb; font-size: 0.75rem; }
    .steps li:last-child { border-right: 0; }
    .steps li[aria-current='step'] { background: #e2e2e2; font-weight: 600; }
    .step-body { margin-top: 10px; border: 1px solid #bbb; padding: 10px; font-size: 0.75rem; line-height: 1.8; }
    .step-body p { margin: 0 0 6px; }
    .tradeoff { margin: 10px 0 0; padding-top: 8px; border-top: 1px dashed #bbb; font-size: 0.6875rem; color: #555; }
    @media (max-width: 35em) {
      .layout-a { grid-template-columns: 1fr; }
      .wfbar button { font-size: 0.6875rem; }
    }
  </style>
</div>
