---
interface Props {
  lines: string[];
  /** 左上角标签，例如「终端」或文件名 */
  label?: string;
  /** 是否显示复制按钮 */
  copyable?: boolean;
}

const { lines, label = '终端', copyable = true } = Astro.props;
---

<figure class="group relative min-w-0 border-l-2 border-accent bg-paper-deep">
  <div class="flex items-center justify-between gap-4 border-b border-rule-soft px-4 py-2">
    <figcaption class="font-mono text-[0.65625rem] uppercase tracking-[0.18em] text-ink-faint">
      {label}
    </figcaption>

    {
      copyable && (
        <span class="copy-feedback" data-copy-feedback>
          <button
            type="button"
            data-copy
            aria-label={`复制${label}代码块`}
            class="-mr-1 flex min-h-6 min-w-6 items-center gap-1.5 px-2 py-1 font-mono text-[0.65625rem] uppercase tracking-[0.14em] text-ink-mute transition-colors hover:text-accent"
          >
            <svg
              data-copy-icon
              width="11"
              height="11"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              aria-hidden="true"
            >
              <rect x="5.5" y="5.5" width="8" height="8" rx="1" />
              <path d="M10.5 5.5V3.5a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2" />
            </svg>
            <svg data-copy-check width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M2.5 8.5l3.5 3.5 7.5-8" />
            </svg>
            <span data-copy-label>复制</span>
          </button>
          {/* live region 必须放在按钮外：按钮子元素是呈现性的，读屏器不一定播报 */}
          <span class="copy-tip" role="status" aria-live="polite" data-copy-tip />
        </span>
      )
    }
  </div>

  <pre class="min-w-0 overflow-x-auto px-4 py-3.5 text-[0.78125rem] leading-[1.7] text-ink-soft"><code>{lines.map((line) => <span class="block whitespace-pre">{line}</span>)}</code></pre>
</figure>

<script>
  // 组件脚本由 Astro 打包后每页只注入一次，统一为所有代码块绑定事件。
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const feedback = btn.closest<HTMLElement>('[data-copy-feedback]');
    const tip = feedback?.querySelector<HTMLElement>('[data-copy-tip]');
    const code = btn.closest('figure')?.querySelector('code');
    if (!feedback || !tip || !code) return;

    let timer = 0;
    let lastMessage = '';
    const report = (ok: boolean, message: string): void => {
      window.clearTimeout(timer);
      feedback.removeAttribute('data-copied');
      feedback.removeAttribute('data-failed');
      tip.textContent = '';
      // VoiceOver 会跳过同一区域中与上一条相同的消息，追加不发音的空格以便重复播报。
      let spoken = message;
      if (spoken === lastMessage) spoken += '\u00A0';
      lastMessage = spoken;
      // 重启动画，让连续点击也能看到反馈；按钮始终可点，不因反馈被禁用。
      void feedback.offsetWidth;
      feedback.setAttribute(ok ? 'data-copied' : 'data-failed', '');
      requestAnimationFrame(() => (tip.textContent = spoken));
      timer = window.setTimeout(() => {
        feedback.removeAttribute('data-copied');
        feedback.removeAttribute('data-failed');
        tip.textContent = '';
      }, 2000);
    };

    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code.innerText.trim());
        report(true, '已复制');
      } catch {
        // 剪贴板被拒绝：选中代码供手动复制，并明确显示失败，而不是静默跳过。
        const range = document.createRange();
        range.selectNodeContents(code);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        report(false, '已选中，请手动复制');
      }
    });
  });
</script>
