---
import { allSkills, skillUrl, type Skill } from '../data/skills';
import { artifactSources } from '../data/artifactSources';
import Router from './artifacts/Router.astro';
import BigPics from './artifacts/BigPics.astro';
import OnePager from './artifacts/OnePager.astro';
import Direction from './artifacts/Direction.astro';
import Wireframe from './artifacts/Wireframe.astro';
import Prototype from './artifacts/Prototype.astro';
import Plan from './artifacts/Plan.astro';
import Diagram from './artifacts/Diagram.astro';

const skills: Skill[] = allSkills;
---

<div class="gallery" data-tabs-scope>
  <div class="grid">
    <div
      class="rail scrollbar-none"
      data-tablist
      role="tablist"
      aria-label="选择要查看的技能成果"
      aria-orientation="vertical"
    >
      {
        skills.map((skill, i) => (
          <button
            type="button"
            role="tab"
            id={`skill-tab-${skill.slug}`}
            data-tab={skill.slug}
            aria-controls={`skill-panel-${skill.slug}`}
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <span class="body">
              <span class="slug">{skill.slug}</span>
              <span class="type">{skill.artifact}</span>
            </span>
          </button>
        ))
      }
    </div>

    <div class="stage">
      {
        skills.map((skill, i) => (
          <div
            class="panel"
            role="tabpanel"
            id={`skill-panel-${skill.slug}`}
            data-panel={skill.slug}
            aria-labelledby={`skill-tab-${skill.slug}`}
            hidden={i > 0}
          >
            <header>
              <p class="eyebrow">{String(i + 1).padStart(2, '0')} / {skill.artifact}</p>
              <h3>{skill.question}</h3>
              <p class="use">{skill.use}</p>
            </header>

            <div class="demo">
              {skill.demo === 'router' && <Router />}
              {skill.demo === 'bigpics' && <BigPics />}
              {skill.demo === 'onepager' && <OnePager />}
              {skill.demo === 'direction' && <Direction />}
              {skill.demo === 'wireframe' && <Wireframe />}
              {skill.demo === 'prototype' && <Prototype />}
              {skill.demo === 'plan' && <Plan />}
              {skill.demo === 'diagram' && <Diagram />}
            </div>

            <div class="meta">
              <div class="contract">
                <h4>这份 SKILL.md 要求</h4>
                <ul>
                  {skill.contract.map((rule) => <li>{rule}</li>)}
                </ul>
              </div>

              <details>
                <summary>查看结构节选</summary>
                <pre><code>{artifactSources[skill.demo]}</code></pre>
              </details>

              <a href={skillUrl(skill.slug)} target="_blank" rel="noopener noreferrer">
                阅读完整 SKILL.md<span class="sr-only">（在新窗口打开）</span>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <style>
    .gallery { min-width: 0; font-family: var(--font-sans); }
    .grid { display: grid; grid-template-columns: minmax(0, 230px) minmax(0, 1fr); gap: 16px; min-width: 0; }
    .rail { min-width: 0; display: flex; flex-direction: column; gap: 4px; }
    .rail button { display: flex; align-items: baseline; gap: 10px; width: 100%; min-width: 0; padding: 9px 10px; border: 1px solid var(--color-rule); background: transparent; text-align: left; cursor: pointer; }
    .rail button[aria-selected='true'] { border-left: 3px solid var(--color-accent); background: var(--color-paper-deep); }
    .rail button:focus-visible { outline-color: var(--color-ink); }
    .num { flex: none; font: 10px var(--font-mono); color: var(--color-accent); }
    .body { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
    .slug { overflow-wrap: anywhere; font: 12px var(--font-mono); color: var(--color-ink); }
    .type { font-size: 11px; color: var(--color-ink-faint); }
    .stage { min-width: 0; }
    .panel { min-width: 0; border: 1px solid var(--color-rule); background: var(--color-paper); }
    header { padding: 16px 18px; border-bottom: 1px solid var(--color-rule); }
    .eyebrow { margin: 0; font: 10px var(--font-mono); text-transform: uppercase; letter-spacing: 0.16em; color: var(--color-ink-faint); }
    h3 { margin: 8px 0 0; font-family: var(--font-serif); font-size: 19px; font-weight: 600; line-height: 1.45; color: var(--color-ink); }
    .use { margin: 8px 0 0; font-size: 12px; line-height: 1.8; color: var(--color-ink-mute); }
    .demo { min-width: 0; padding: 16px 18px; background: #fffdf9; }
    .meta { min-width: 0; padding: 14px 18px 18px; border-top: 1px solid var(--color-rule); }
    .contract h4 { margin: 0 0 8px; font-family: var(--font-sans); font-size: 11px; font-weight: 600; letter-spacing: 0; color: var(--color-ink); }
    .contract ul { margin: 0; padding-left: 18px; font-size: 12px; line-height: 1.85; color: var(--color-ink-soft); }
    details { margin-top: 12px; border-top: 1px solid var(--color-rule-soft); padding-top: 10px; }
    summary { font: 11px var(--font-mono); color: var(--color-ink-mute); cursor: pointer; }
    pre { min-width: 0; max-width: 100%; overflow-x: auto; margin: 10px 0 0; padding: 12px; background: var(--color-paper-deep); font: 11px/1.7 var(--font-mono); color: var(--color-ink-soft); }
    .meta > a { display: inline-block; margin-top: 12px; font: 11px var(--font-mono); color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }
    @media (max-width: 860px) {
      .grid { grid-template-columns: 1fr; }
      .rail { flex-direction: row; overflow-x: auto; padding-bottom: 4px; }
      .rail button { flex: 0 0 auto; width: auto; min-width: 132px; }
    }
  </style>
</div>
